{
  "expo": {
    "name": "Glovebox",
    "slug": "glovebox",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "glovebox",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F12"
    },
    "ios": {
      "bundleIdentifier": "app.glovebox.mobile",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Glovebox needs photo access to attach vehicle photos and receipts.",
        "NSCameraUsageDescription": "Glovebox needs camera access to capture vehicle photos and receipts.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.glovebox.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0F12"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Glovebox to access your photos for vehicle images and receipts.",
          "cameraPermission": "Allow Glovebox to use the camera for vehicle photos and receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d18bfa89-3fcc-453e-b09d-0467c082b375"
      }
    },
    "owner": "ramos91"
  }
}
