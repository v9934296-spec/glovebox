{
  "expo": {
    "name": "Glovebox",
    "slug": "glovebox",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "glovebox",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.glovebox.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.glovebox.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
