# Mobile public configuration. Without Supabase values the app intentionally
# boots into local-only mode and all core records remain on the device.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# RevenueCat public SDK keys. Safe for the mobile binary.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-ios-public-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-android-public-key

# SERVER-ONLY secrets — set with `supabase secrets set`, never EXPO_PUBLIC_* and
# never commit real values. AI entitlement checks and account deletion fail
# closed when the RevenueCat server key is missing.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# REVENUECAT_SERVER_API_KEY=sk_your-revenuecat-secret-key
