# Supabase project credentials (Dashboard -> Project Settings -> API).
# Without these the app runs in local-only mode (no accounts, no sync).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# RevenueCat public SDK keys (Project Settings → API keys).
# Platform keys (appl_ / goog_) for store builds. Test Store key for local/dev only —
# never submit an App Store or Play build configured with the test key.
# Without these the app stays on the free tier and the paywall shows
# "purchases not available in this build".
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-ios-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-android-key
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_your-test-store-key

# Public origin of the Railway legal site (no trailing path required).
# Without this, Privacy Policy / Terms links are hidden so they never open a dead URL.
EXPO_PUBLIC_LEGAL_BASE_URL=https://glovebox-legal.up.railway.app
